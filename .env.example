# Simkl watch lists on /after-hours (see README > Watch lists (Simkl)). Leave blank to hide them.
SIMKL_CLIENT_ID=
SIMKL_REFRESH_TOKEN=

# Top Spotify track in the /after-hours Music block (see README > Music (Spotify)). Leave blank to use the Keystatic content.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam games in the /after-hours Gaming block (see README > Games (Steam)). Leave blank to hide them.
STEAM_API_KEY=
STEAM_ID=
